<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="/users" method="post">
        <label for="firstName">
            First Name
            <input type="text" name="firstName" value ="<%= locals.firstName %>">
        </label>
         <label for="lastName">
            Last Name
            <input type="text" name="lastName" value ="<%= locals.lastName %>">
        </label>
        <label for ="age">
            Age
            <input type="text" name="age" value="<%= locals.age%>">
        </label>
        <label for="male">Male<input type="radio" name="gender" value="male"></label>
        <label for="female">Male<input type="radio" name="gender" value="female"></label>
        <button type="submit">Submit</button>
    </form>
</body>
</html>
